{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "digestly",
  "version": "0.1.0",
  "identifier": "com.digestly.app",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm -C ../web dev",
    "beforeBuildCommand": "pnpm -C ../web build"
  },
  "app": {
    "windows": [
      {
        "title": "digestly",
        "width": 1200,
        "height": 800
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:* http://localhost:*; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/digestly-server"
    ]
  }
}